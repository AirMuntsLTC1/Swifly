+                child: Row(
+                  children: [
+                    const Icon(LucideIcons.hash, size: 16, color: kHashtagBlue),
+                    const SizedBox(width: 6),
+                    const Text('Hashtags',
+                        style: TextStyle(fontWeight: FontWeight.w800, fontSize: 14, color: Colors.black)),
+                    const Spacer(),
